<Window x:Class="ChromeGridLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChromeGridLauncher.ViewModels"
        xmlns:controls="clr-namespace:ChromeGridLauncher.Views.Controls"
        Title="⚡ Chrome Grid Launcher - High Concurrency Native Turbo Sync"
        Height="950" Width="1500"
        MinHeight="750" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Top Control & Preset Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Viewport -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- TOP CONTROL BAR -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: App Brand, Workspaces, Primary Launch Actions -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- Brand & Workspace Tabs -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppBrandTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <!-- Segmented Workspace Tabs -->
                        <Border Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🖥️ Grid Canvas" Command="{Binding SelectWorkspaceTabCommand}" CommandParameter="grid" Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGridTabActive}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="⚡ Thunder Config" Command="{Binding SelectWorkspaceTabCommand}" CommandParameter="thunder" Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsThunderTabActive}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="⏱️ Slot Time" Command="{Binding SelectWorkspaceTabCommand}" CommandParameter="slot_time" Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSlotTimeTabActive}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="🔄 Remote Refresh" Command="{Binding SelectWorkspaceTabCommand}" CommandParameter="refresh" Padding="12,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshTabActive}" Value="True">
                                                    <Setter Property="Background" Value="#2563EB" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Master Controls -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Primary Launch Button (Dynamic color & text) -->
                        <Button Content="{Binding LaunchButtonText}" Command="{Binding LaunchAllCommand}"
                                Foreground="White" FontWeight="Bold" FontSize="13" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{Binding DataContext.LaunchButtonColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="🔄 Hard Refresh All" Command="{Binding HardRefreshAllCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Padding="12,8" ToolTip="{Binding HardRefreshTooltip}" />
                        <Button Content="📐 Tile" Command="{Binding TileWindowsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,8" ToolTip="{Binding TileBrowserTooltip}" />
                        <Button Content="{Binding CloseBrowserButtonText}" Command="{Binding CloseManagedBrowserCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,12,0" Padding="12,8" ToolTip="{Binding CloseBrowserTooltip}" />
                        <Button Content="⚙️ Settings" Command="{Binding OpenSettingsModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" />
                    </StackPanel>
                </DockPanel>

                <!-- Row 2: Grid Presets, Spacing, Screen Mode, Monitor Select -->
                <DockPanel Grid.Row="1">
                    <!-- Presets & Gaps -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Presets:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <Button Content="2×2" Command="{Binding SetGridPresetCommand}" CommandParameter="2x2" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="3×3" Command="{Binding SetGridPresetCommand}" CommandParameter="3x3" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="4×4" Command="{Binding SetGridPresetCommand}" CommandParameter="4x4" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="4×6" Command="{Binding SetGridPresetCommand}" CommandParameter="4x6" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="5×10 (50w)" Command="{Binding SetGridPresetCommand}" CommandParameter="5x10" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}"/>
                        <Button Content="10×5 (50w)" Command="{Binding SetGridPresetCommand}" CommandParameter="10x5" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}"/>
                        <Button Content="Custom..." Command="{Binding OpenCustomGridModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,14,0" FontSize="11"/>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,14,2" />

                        <TextBlock Text="Gap:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <Button Content="0px (Max Res)" Command="{Binding SetGapCommand}" CommandParameter="0" Padding="8,4" Margin="0,0,4,0" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGap0Active}" Value="True">
                                            <Setter Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="BorderBrush" Value="#60A5FA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="2px" Command="{Binding SetGapCommand}" CommandParameter="2" Padding="8,4" Margin="0,0,4,0" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGap2Active}" Value="True">
                                            <Setter Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="BorderBrush" Value="#60A5FA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="4px" Command="{Binding SetGapCommand}" CommandParameter="4" Padding="8,4" Margin="0,0,14,0" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGap4Active}" Value="True">
                                            <Setter Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="BorderBrush" Value="#60A5FA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,14,2" />

                        <Button Content="{Binding ScreenModeText}" Command="{Binding ToggleScreenModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" FontSize="11" ToolTip="Toggle Fullscreen vs Work Area (preserving taskbar)"/>
                        <Button Content="{Binding WindowSizeModeText}" Command="{Binding ToggleCustomSizeModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,14,0" FontSize="11" ToolTip="Toggle Auto-Fit Grid vs Manual Window Sizing"/>
                    </StackPanel>

                    <!-- Browser & Monitor Selection & Target URL -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Browser:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableBrowsers}" SelectedItem="{Binding SelectedBrowserOption}" Width="110" Height="28" VerticalContentAlignment="Center" Margin="0,0,12,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Display:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="DisplayLabel" SelectedItem="{Binding SelectedMonitor}" Width="160" Height="28" VerticalContentAlignment="Center" Margin="0,0,12,0"/>

                        <TextBlock Text="Target:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="28" Padding="6,3" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN VIEWPORT (SIDEBAR + 3 WORKSPACES) -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (Profiles) -->
                <ColumnDefinition Width="320" />
                <!-- Center Workspaces -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: PROFILES -->
            <Border Grid.Column="0" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14" Margin="0,0,10,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ProfilesHeaderTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↻ Scan" Command="{Binding RefreshProfilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="✨ Group" Command="{Binding OpenNewGroupModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Group Filter Chips -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <ListBox ItemsSource="{Binding ProfileGroups}" SelectedItem="{Binding SelectedGroupFilter}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12" Padding="8,3" Margin="0,0,4,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Search Input -->
                    <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="8,3" Margin="0,0,0,8" FontSize="12" VerticalContentAlignment="Center" />

                    <!-- Quick Fill & Clear Buttons -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⚡ Auto Fill Grid" Command="{Binding AutoPopulateGridCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Padding="8,5" FontSize="11" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="🗑️ Clear Grid" Command="{Binding ClearGridCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Padding="8,5" FontSize="11" Foreground="#EF4444"/>
                    </Grid>

                    <!-- Filtered Profile List -->
                    <ListBox Grid.Row="4" ItemsSource="{Binding FilteredProfiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:ProfileCardControl DataContext="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer Tip -->
                    <Border Grid.Row="5" Background="{StaticResource BgDarkBrush}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                        <TextBlock Text="💡 Click a profile, then click a cell to place. 🛡️ denotes protected profiles." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- WORKSPACE 1: GRID CANVAS -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsGridTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Canvas Top Controls -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Interactive Visual Grid Canvas" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="10" Padding="8,2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold">
                                    <Run Text="{Binding GridRows, Mode=OneWay}" />
                                    <Run Text="×" />
                                    <Run Text="{Binding GridCols, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding GridCells.Count, Mode=OneWay}" />
                                    <Run Text=" cells)" />
                                </TextBlock>
                            </Border>

                            <!-- Live Window Size Indicator -->
                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="Active window size per browser window">
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <Run Text="📐 Window Size:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding CurrentCellResolutionText, Mode=OneWay}" Foreground="#38BDF8" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- Size Mode Buttons: Auto-Fit vs Manual -->
                            <Button Content="Auto-Fit" Command="{Binding SetAutoFitModeCommand}" Padding="8,3" Margin="0,0,3,0" FontSize="11" ToolTip="Windows automatically fill 100% of the display area">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoFitActive}" Value="True">
                                                <Setter Property="Background" Value="#2563EB" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Manual" Command="{Binding SetManualSizeModeCommand}" Padding="8,3" Margin="0,0,8,0" FontSize="11" ToolTip="Use fixed custom Width and Height">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManualSizeActive}" Value="True">
                                                <Setter Property="Background" Value="#2563EB" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderBrush" Value="#60A5FA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Width Nudge Controls -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="W:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="-" Command="{Binding NudgeWidthCommand}" CommandParameter="-20" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="0,0,2,0" FontSize="11" FontWeight="Bold" Width="22" Height="24" ToolTip="Decrease Width by 20px"/>
                                <TextBox Text="{Binding CustomWindowWidthText, UpdateSourceTrigger=LostFocus}" Width="48" Height="24" Padding="2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                <Button Content="+" Command="{Binding NudgeWidthCommand}" CommandParameter="20" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="2,0,0,0" FontSize="11" FontWeight="Bold" Width="22" Height="24" ToolTip="Increase Width by 20px"/>
                            </StackPanel>

                            <!-- Height Nudge Controls -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="H:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="-" Command="{Binding NudgeHeightCommand}" CommandParameter="-20" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="0,0,2,0" FontSize="11" FontWeight="Bold" Width="22" Height="24" ToolTip="Decrease Height by 20px"/>
                                <TextBox Text="{Binding CustomWindowHeightText, UpdateSourceTrigger=LostFocus}" Width="48" Height="24" Padding="2,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                <Button Content="+" Command="{Binding NudgeHeightCommand}" CommandParameter="20" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="2,0,0,0" FontSize="11" FontWeight="Bold" Width="22" Height="24" ToolTip="Increase Height by 20px"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Hard Refresh All" Command="{Binding HardRefreshAllCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Padding="12,4" FontSize="11" FontWeight="Bold" ToolTip="{Binding HardRefreshTooltip}" />
                            <Button Content="🎛️ Fine Control" Command="{Binding OpenFineControlModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Nudge individual cell positions or column/row weights" />
                            <Button Content="💾 Save Layout" Command="{Binding OpenSaveLayoutModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                            <Button Content="📂 Load Layout" Command="{Binding OpenLoadLayoutModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Visual Grid Canvas Container -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GridCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Columns="{Binding DataContext.GridCols, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:GridCellCardControl DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- WORKSPACE 2: THUNDER CONFIGURATEUR -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsThunderTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Unified Config Bar (Row 0) -->
                        <RowDefinition Height="Auto" />
                        <!-- Conflict Status Banner (Row 1) -->
                        <RowDefinition Height="Auto" />
                        <!-- Selection & Bulk Action Hub (Row 2) -->
                        <RowDefinition Height="Auto" />
                        <!-- Thunder Matrix View (Row 3) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Thunder Unified Config Hero Box -->
                    <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Line 1: Region & Presets -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Thunder Configurateur" Foreground="{StaticResource AccentAmberBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <!-- Region Toggle -->
                                    <ComboBox SelectedValue="{Binding ThunderRegion}" SelectedValuePath="Content" Width="140" Height="28" Margin="0,0,12,0">
                                        <ComboBoxItem Content="Spain" IsSelected="True" />
                                        <ComboBoxItem Content="Portugal" />
                                    </ComboBox>
                                    <TextBlock Text="{Binding ThunderRegionTag}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Presets -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Preset:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding ThunderPresetNames}" SelectedItem="{Binding ThunderPresetName}" Width="140" Height="28" Margin="0,0,6,0"/>
                                    <Button Content="💾 Save" Command="{Binding ThunderSavePresetCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Padding="8,4" FontSize="11"/>
                                    <Button Content="🗑️ Delete" Command="{Binding ThunderDeletePresetCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Foreground="#EF4444"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Line 2: Unified Config Inputs & Push Action -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Visa Type" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableVisaTypes}" SelectedItem="{Binding ThunderVisaType}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Center / City" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableCenters}" SelectedItem="{Binding ThunderCenter}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                    <TextBlock Text="Category" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding ThunderCategory}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="6,0,6,0">
                                    <TextBlock Text="Members" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AvailableMembers}" SelectedItem="{Binding ThunderMembers}" Height="28"/>
                                </StackPanel>

                                <Button Grid.Column="4" Content="⚡ Apply to Selected" Command="{Binding ApplyThunderUnifiedConfigCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="14,0" Margin="6,15,0,0" ToolTip="Broadcast this visa configuration to all selected matrix tiles"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Conflict Status & Auto-Fix Banner -->
                    <Border Grid.Row="1" Background="{StaticResource BgDarkBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                            BorderBrush="{Binding ConflictBannerColor}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="{Binding ConflictBannerText}" Foreground="{Binding ConflictBannerColor}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
