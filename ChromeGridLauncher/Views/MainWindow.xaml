                                    Style="{StaticResource WarningButtonStyle}" Height="24" Padding="10,0" FontSize="10" FontWeight="Bold"
                                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                                    Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="Automatically replaces duplicate profile assignments with unused available profiles"/>
                        </DockPanel>
                    </Border>

                    <!-- Selection & Bulk Action Hub -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Select:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content="All" Command="{Binding ThunderSelectAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0" FontSize="11"/>
                            <Button Content="None" Command="{Binding ThunderDeselectAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0" FontSize="11"/>
                            <Button Content="Invert" Command="{Binding ThunderInvertSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,3" Margin="0,0,4,0" FontSize="11"/>
                            <!-- Dynamic Row Selection Buttons -->
                            <ItemsControl ItemsSource="{Binding ThunderRowSelectors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding SelectCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="7,3" Margin="0,0,4,0" FontSize="11"
                                                ToolTip="Toggle selection for all Chrome instances in this row" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- City Fast Filters -->
                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,8,2" />
                            <TextBlock Text="By City:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold"/>
                            <Button Content="Casa" Command="{Binding ThunderSelectByCityCommand}" CommandParameter="Casablanca" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="0,0,3,0" FontSize="10"/>
                            <Button Content="Rabat" Command="{Binding ThunderSelectByCityCommand}" CommandParameter="Rabat" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="0,0,3,0" FontSize="10"/>
                            <Button Content="Tangier" Command="{Binding ThunderSelectByCityCommand}" CommandParameter="Tangier" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Margin="0,0,8,0" FontSize="10"/>

                            <!-- Smart Distribution Actions -->
                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,8,2" />
                            <Button Content="⚖️ Distribute Evenly" Command="{Binding ThunderDistributeEvenlyCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,4,0" FontSize="11" ToolTip="Split selected cells evenly across all available centers for this region"/>
                            <Button Content="🏷️ Group Match" Command="{Binding ThunderDistributeByGroupCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" ToolTip="Assign Portugal config to PRT group profiles and Spain to others"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ThunderTargetCountText}" Foreground="{StaticResource AccentBlueBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Thunder Matrix Grid -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ThunderCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Columns="{Binding DataContext.GridCols, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ThunderCellCardControl DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- WORKSPACE 2b: TIMED SLOT INPUT CLICKER -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsSlotTimeTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Hero Header Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Dual Cards Row (Page A Calendar + Page B VisaType) -->
                        <RowDefinition Height="*" />
                        <!-- Master Send Row -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hero Header Card -->
                    <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️ Timed Slot Input Clicker" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,12,0"/>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,3" BorderBrush="#3B82F6" BorderThickness="1">
                                        <TextBlock Text="⚡ BLS Slot Synchronization Engine" Foreground="#93C5FD" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="⚡ Hot Reload Script in Open Tabs" Command="{Binding LiveUpdateScriptInOpenTabsCommand}" Style="{StaticResource WarningButtonStyle}" Padding="12,5" FontSize="11" ToolTip="Hot-push newest JS script logic directly into open browser sessions"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                       Text="Configure Sec, MS, and independent Step Count (&quot;Delay&quot;) for each page. Each page has its own dedicated Send button and increments its own step independently per Chrome window." />
                        </Grid>
                    </Border>

                    <!-- Dual Cards Row (Page A Calendar + Page B VisaType) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Page A — Calendar -->
                        <Border Grid.Column="0" Background="#0C1322" CornerRadius="10" Padding="16" Margin="0,0,8,0" BorderBrush="#1D4ED8" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Border Background="#1D4ED8" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" DockPanel.Dock="Left">
                                        <TextBlock Text="PAGE A" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Page A — Calendar" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- URL Hint -->
                                <TextBlock Grid.Row="1" Text="morocco.blsportugal.com/.../SlotSelection • XPath input[2] (sec) / input[3] (ms)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontFamily="Consolas" Margin="0,0,0,10"/>

                                <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                                <!-- Fields -->
                                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                                    <!-- Seconds -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Seconds (sec)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SlotASec, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="0–59" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Milliseconds -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Milliseconds (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SlotAMs, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="0–999" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- MS Step Delay -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MS Step (&quot;Delay&quot;) / Chrome" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SlotAStep, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="0–999" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Helper note -->
                                <TextBlock Grid.Row="4" Text="ℹ️ Chrome 1: ms=base  •  Chrome 2: ms=base+step  •  Chrome N: ms=base+(N−1)×step" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- Dedicated Button -->
                                <Button Grid.Row="5" Content="⚡ SEND CALENDAR (PAGE A)" Command="{Binding TriggerSlotClickACommand}" Height="42" FontSize="12" FontWeight="Bold" Background="#1D4ED8" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: Page B — VisaType -->
                        <Border Grid.Column="1" Background="#062016" CornerRadius="10" Padding="16" Margin="8,0,0,0" BorderBrush="#059669" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Border Background="#059669" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" DockPanel.Dock="Left">
                                        <TextBlock Text="PAGE B" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Page B — VisaType" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- URL Hint -->
                                <TextBlock Grid.Row="1" Text="morocco.blsportugal.com • #InputSec / #InputMs" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontFamily="Consolas" Margin="0,0,0,10"/>

                                <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                                <!-- Fields -->
                                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                                    <!-- Seconds -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Seconds (sec)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SlotBSec, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="0–59" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Milliseconds -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Milliseconds (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SlotBMs, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="0–999" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- MS Step Delay -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MS Step (&quot;Delay&quot;) / Chrome" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SlotBStep, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="14" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="0–999" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Helper note -->
                                <TextBlock Grid.Row="4" Text="ℹ️ Chrome 1: ms=base  •  Chrome 2: ms=base+step  •  Chrome N: ms=base+(N−1)×step" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- Dedicated Button -->
                                <Button Grid.Row="5" Content="⚡ SEND VISATYPE (PAGE B)" Command="{Binding TriggerSlotClickBCommand}" Height="42" FontSize="12" FontWeight="Bold" Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Master Send Row -->
                    <Button Grid.Row="2" Content="⚡ BROADCAST SLOT VALUES TO ALL PAGES (PAGE A + PAGE B)" Command="{Binding TriggerSlotClickAllCommand}" Height="46" FontSize="13" FontWeight="Bold" Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- WORKSPACE 3: REMOTE REFRESH SERVER -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsRefreshTabActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Server Header & Actions -->
                        <RowDefinition Height="Auto" />
                        <!-- Global Extension Hub Card ("Change Once, Change in All") -->
                        <RowDefinition Height="Auto" />
                        <!-- Broadcast Controls Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Lower Split (Connected Tabs + Activity Logs) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Server Header & Actions -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄 Remote Refresh Server" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,12,0"/>
                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="10" Padding="10,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding ServerPillColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ServerPillText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#122A20" CornerRadius="10" Padding="10,3" BorderBrush="#10B981" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧩 Native Extension: Global Location Sync" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

