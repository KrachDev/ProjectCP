                            <Button Content="Ping Tabs" Command="{Binding PingAllTabsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11"/>
                            <Button Content="📋 Copy Script" Command="{Binding CopyUserscriptCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Copy Tampermonkey Userscript code to clipboard (Optional Fallback)"/>
                            <Button Content="🌐 Install Script" Command="{Binding OpenInstallScriptPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11" ToolTip="Open http://127.0.0.1:8765/userscript.user.js in Chrome (Optional Fallback)"/>
                            <Button Content="⚡ Hot Reload Tabs" Command="{Binding LiveUpdateScriptInOpenTabsCommand}" Style="{StaticResource WarningButtonStyle}" Padding="10,4" FontSize="11" ToolTip="Hot-push newest JS script logic directly into open browser sessions"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Global Extension Hub Card ("Change Once, Change in All") -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="#3B82F6" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="🧩 Global Extension Hub" Foreground="{StaticResource AccentBlueBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <Border Background="#1E293B" CornerRadius="6" Padding="8,3" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,10,0">
                                        <TextBlock Text="📁 C:\ChromeGridExtension" Foreground="#93C5FD" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#122A20" CornerRadius="6" Padding="6,2" BorderBrush="#10B981" BorderThickness="1">
                                        <TextBlock Text="Change Once, Change in All Profiles" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="📋 Copy Path" Command="{Binding CopyExtensionPathCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" FontSize="11" ToolTip="Copy 'C:\ChromeGridExtension' to clipboard"/>
                                    <Button Content="📂 Open Folder" Command="{Binding OpenExtensionFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" FontSize="11" ToolTip="Open C:\ChromeGridExtension in File Explorer"/>
                                    <Button Content="{Binding OpenExtensionsPageButtonText}" Command="{Binding OpenChromeExtensionsPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" FontSize="11" ToolTip="{Binding OpenExtensionsPageTooltip}"/>
                                    <Button Content="⚡ Force Reload Everywhere" Command="{Binding ReloadAllExtensionsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" FontSize="11" ToolTip="Broadcast zero-click reload command to all running Chrome extensions"/>
                                    <Button Content="🔄 Sync Latest Files" Command="{Binding SyncGlobalExtensionCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="10,4" FontSize="11" ToolTip="Re-extract, update files, and auto-reload extension across all running Chrome windows"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Background="#0B1120" CornerRadius="6" Padding="10,6" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="💡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" LineHeight="16">
                                        <Run Text="Quick Setup:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Run Text=" 1) Click "/>
                                        <Run Text="🌐 Open chrome://extensions" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                                        <Run Text=" (or open in Chrome). 2) Turn on "/>
                                        <Run Text="Developer mode" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Run Text=" toggle (top right). 3) Click "/>
                                        <Run Text="Load unpacked" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Run Text=" and paste "/>
                                        <Run Text="C:\ChromeGridExtension" FontWeight="Bold" Foreground="#93C5FD"/>
                                        <Run Text=". Done! All profiles reference this exact same folder on disk; updating it here updates all 50 profiles simultaneously without reinstalling."/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Broadcast Controls Box -->
                    <Border Grid.Row="2" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Target Button XPath" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding RefreshXPath, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Button Text" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding RefreshText, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                    <TextBlock Text="Button Class" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding RefreshClassName, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="6,0,6,0">
                                    <TextBlock Text="Stagger (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding StaggerMs, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="6,0,0,0">
                                    <TextBlock Text="Auto Interval" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox SelectedValue="{Binding AutoRefreshChoice}" SelectedValuePath="Content" Height="28">
                                        <ComboBoxItem Content="Off" IsSelected="True" />
                                        <ComboBoxItem Content="5s" />
                                        <ComboBoxItem Content="10s" />
                                        <ComboBoxItem Content="15s" />
                                        <ComboBoxItem Content="30s" />
                                        <ComboBoxItem Content="60s" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Broadcast Action Button -->
                            <Button Grid.Row="1" Content="🔄 BROADCAST TRIGGER REFRESH TO ALL TABS" Command="{Binding TriggerRefreshAllCommand}"
                                    Style="{StaticResource SuccessButtonStyle}" Height="34" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Lower Split (Connected Tabs + Activity Logs) -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Connected Tabs DataGrid -->
                        <Border Grid.Column="0" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="10" Margin="0,0,6,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Connected Tabs" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ConnectedTabs.Count, StringFormat='Total: {0}'}" Foreground="{StaticResource AccentBlueBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding ConnectedTabs}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#121826"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" BorderThickness="0" HeadersVisibility="Column">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tab ID" Binding="{Binding TabId}" Width="100"/>
                                        <DataGridTextColumn Header="Page Title" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="180"/>
                                        <DataGridTextColumn Header="Refreshes" Binding="{Binding RefreshCount}" Width="70"/>
                                        <DataGridTextColumn Header="Latency" Binding="{Binding LastDurationMs, StringFormat={}{0} ms}" Width="70"/>
                                        <DataGridTextColumn Header="Session" Binding="{Binding SessionCountdownText}" Width="105"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Live Activity Log -->
                        <Border Grid.Column="1" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="10" Margin="6,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Live Activity Log" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"/>
                                    <Button Content="Clear" Command="{Binding ClearActivityLogCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="6,2" FontSize="10"/>
                                </DockPanel>

                                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLogs}" Background="Transparent" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- BOTTOM STATUS BAR -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="{StaticResource CardDarkBrush}" CornerRadius="6" Padding="12,6" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Server Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ServerPillColor}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ServerPillText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>

                <!-- Right: Profile count & Launch Progress Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding LaunchProgress}" Maximum="1.0" Width="120" Height="8" Margin="0,0,10,0"
                                 Visibility="{Binding LaunchProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    <TextBlock Text="{Binding ProfileCountText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
