<Window x:Class="ChromeGridLauncher.Views.Modals.FineControlModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📐 Fine Position &amp; Screen Calibration" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📐 Fine Position &amp; Screen Fit Calibration" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <!-- Screen Mode (Full Screen vs Work Area) -->
            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Display Mode:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadioWorkArea" Content="🖥️ Work Area (Excluding Taskbar)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RadioFullScreen" Content="📺 Full Screen (Edge-to-Edge)" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Screen Margins -->
            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Custom Screen Margins (px):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Top" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtMarginTop" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                            <TextBlock Text="Bottom" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtMarginBottom" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                            <TextBlock Text="Left" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtMarginLeft" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtMarginRight" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DWM Border Shadow Compensation -->
            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="ChkShadowCompensate" Content="Compensate Windows DWM Drop-Shadows (Pixel-Perfect 0px Edge Snapping)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DWM Shadow Offset (px):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtShadowOffset" Text="7" Width="50" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reset to Defaults" Click="OnResetClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="14,7" />
            <Button Content="Apply Calibration" Click="OnApplyClick" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" />
        </StackPanel>
    </Grid>
</Window>
