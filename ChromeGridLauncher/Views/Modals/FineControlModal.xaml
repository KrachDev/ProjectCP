<Window x:Class="ChromeGridLauncher.Views.Modals.FineControlModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📐 Fine Position &amp; Screen Calibration" Height="580" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📐 Fine Position &amp; Window Size Calibration" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Window Sizing Mode (Auto vs Manual) -->
                <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Window Sizing Mode:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RadioAutoFit" Content="⚡ Auto-Fit Grid (Fills 100% Display)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <RadioButton x:Name="RadioCustomSize" Content="📐 Manual Custom Size (Fixed W×H)" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Window Width (px):" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomWidth" Text="960" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="6" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Window Height (px):" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomHeight" Text="540" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="6" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Screen Mode (Full Screen vs Work Area) -->
                <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Display Mode:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioWorkArea" Content="🖥️ Work Area (Excluding Taskbar)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <RadioButton x:Name="RadioFullScreen" Content="📺 Full Screen (Edge-to-Edge)" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Screen Margins -->
                <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Custom Screen Margins (px):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Top" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtMarginTop" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Bottom" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtMarginBottom" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                <TextBlock Text="Left" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtMarginLeft" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtMarginRight" Text="0" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DWM Border Shadow Compensation -->
                <Border Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="ChkShadowCompensate" Content="Compensate Windows DWM Drop-Shadows (OFF = No Overlapping/Shadows)" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="💡 Leave OFF to stop adjacent windows from overlapping and casting shadows over each other." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DWM Shadow Offset (px):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtShadowOffset" Text="0" Width="50" Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="4" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reset to Defaults" Click="OnResetClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="12,7" />
            <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="14,7" />
            <Button Content="Apply Calibration" Click="OnApplyClick" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" />
        </StackPanel>
    </Grid>
</Window>
