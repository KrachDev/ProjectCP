<Window x:Class="ChromeGridLauncher.Views.Modals.SaveLayoutModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Grid Layout Preset" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="💾 Save Layout Preset" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Preset Name" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="TxtLayoutName" Height="36" Padding="8,6" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="16,8" />
            <Button Content="Save Preset" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
