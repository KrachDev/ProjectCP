<Window x:Class="ChromeGridLauncher.Views.Modals.SettingsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chrome Grid Launcher Settings" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ Application Settings" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel Margin="0,0,10,0">
                <!-- Chrome Path -->
                <TextBlock Text="Chrome Executable Path Override (Leave blank for auto-detect)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Browse..." Click="OnBrowseChromeClick" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,4"/>
                    <TextBox x:Name="TxtChromeExe" Height="32" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center"/>
                </DockPanel>

                <!-- Target URL -->
                <TextBlock Text="Default Target URL" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTargetUrl" Height="32" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <!-- Port & Stagger -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Refresh Server Port" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPort" Text="8765" Height="32" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Launch Interval (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLaunchInterval" Text="400" Height="32" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Timeout & Protected Profile -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Window Timeout (s)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWindowTimeout" Text="8.0" Height="32" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Protected Profile Key" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProtectedProfile" Text="Default" Height="32" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Checkboxes -->
                <CheckBox x:Name="ChkEnableNativeExtension" Content="Auto-inject Native Chrome Extension on launch (Zero-Install, Isolated Context)" IsChecked="True" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,4,0,8" FontWeight="Bold"/>
                <CheckBox x:Name="ChkSoundAlerts" Content="Enable Audio Sound Alerts on Captcha/Success" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                <CheckBox x:Name="ChkDwmCompensation" Content="Enable DWM Shadow Compensation (Pixel-perfect border alignment)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                <CheckBox x:Name="ChkMinimizeOnLaunch" Content="Minimize Launcher Window during batch launch" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="16,8"/>
            <Button Content="Save Settings" Click="OnSaveClick" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
