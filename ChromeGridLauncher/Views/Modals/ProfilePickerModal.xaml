<Window x:Class="ChromeGridLauncher.Views.Modals.ProfilePickerModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Profile to Grid Cell" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🌐 Select Profile for Grid Cell" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBox Grid.Row="1" x:Name="TxtSearch" TextChanged="OnSearchTextChanged" Height="34" Padding="8,4" Background="{StaticResource CardDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <Border Grid.Row="2" Background="{StaticResource CardDarkBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <ListBox x:Name="ProfilesListBox" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnProfileDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,6">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{Binding GroupColor}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text=" 🛡️" Visibility="{Binding IsProtected, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear Cell Profile" Click="OnClearClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,8" Foreground="#EF4444" />
            <Button Content="Assign Profile" Click="OnAssignClick" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
