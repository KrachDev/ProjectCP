<Window x:Class="ChromeGridLauncher.Views.Modals.CustomGridModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Grid Dimensions"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="📐 Set Grid Dimensions" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Sliders / Controls -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Rows Row -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Rows (Vertical):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding Rows, RelativeSource={RelativeSource AncestorType=Window}}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Rows, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Columns Row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Cols (Horizontal):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding Cols, RelativeSource={RelativeSource AncestorType=Window}}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Cols, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Quick Presets -->
            <TextBlock Text="Quick Presets:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="2×2" Click="OnPresetClick" Tag="2,2" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4" FontSize="10"/>
                <Button Content="3×3" Click="OnPresetClick" Tag="3,3" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4" FontSize="10"/>
                <Button Content="4×4" Click="OnPresetClick" Tag="4,4" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4" FontSize="10"/>
                <Button Content="4×6 (24)" Click="OnPresetClick" Tag="4,6" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4" FontSize="10"/>
                <Button Content="5×10 (50)" Click="OnPresetClick" Tag="5,10" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4" FontSize="10"/>
                <Button Content="10×5 (50)" Click="OnPresetClick" Tag="10,5" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="8,4" FontSize="10"/>
            </WrapPanel>
        </StackPanel>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="14,6"/>
            <Button Content="Apply Grid" Click="OnApplyClick" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
