<UserControl x:Class="ChromeGridLauncher.Views.Controls.ThunderCellCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonUp="OnTileClick">
    <Border Background="{Binding CardBgColor}"
            CornerRadius="8"
            Padding="8,7"
            Margin="3"
            BorderBrush="{Binding CardBorderColor}"
            BorderThickness="{Binding CardBorderThickness}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top Row: Checkbox, Index, Selected / Conflict Badge -->
                <RowDefinition Height="Auto" />
                <!-- Profile Name & Group Dot -->
                <RowDefinition Height="Auto" />
                <!-- Center City Pill Badge -->
                <RowDefinition Height="Auto" />
                <!-- Visa Type Title -->
                <RowDefinition Height="*" />
                <!-- Bottom Metadata: Category & Pax -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Selection Status -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Center" Focusable="False"/>
                    <TextBlock Text="{Binding CellTag}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CoordinatesTag}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Conflict Badge -->
                    <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,4,0"
                            Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⚠️ CONFLICT" Foreground="#FCA5A5" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <!-- Selected Badge -->
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,1"
                            Visibility="{Binding SelectionBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="✓ SELECTED" Foreground="#6EE7B7" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: Profile Name with Group Color Dot -->
            <DockPanel Grid.Row="1" Margin="0,0,0,4">
                <Ellipse Width="7" Height="7" Fill="{Binding ProfileGroupColor}" VerticalAlignment="Center" Margin="0,0,5,0" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding ProfileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <!-- Row 2: Center / City Pill Badge (Clean Pill, NOT Whole-Card Paint) -->
            <Border Grid.Row="2" Background="{Binding PillBg}" BorderBrush="{Binding PillBorder}" BorderThickness="1"
                    CornerRadius="5" Padding="8,2" HorizontalAlignment="Left" Margin="0,2,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📍 " FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CityTag}" Foreground="{Binding PillText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Row 3: Visa Type -->
            <TextBlock Grid.Row="3" Text="{Binding VisaType}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                       FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

            <!-- Row 4: Bottom Metadata (Category & Pax) -->
            <DockPanel Grid.Row="4" Margin="0,2,0,0">
                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="5,1" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding MembersText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
