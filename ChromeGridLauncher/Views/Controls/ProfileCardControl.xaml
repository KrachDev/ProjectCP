<UserControl x:Class="ChromeGridLauncher.Views.Controls.ProfileCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonUp="OnCardClick">
    <Border Background="{StaticResource CardDarkBrush}"
            CornerRadius="8"
            Padding="8"
            Margin="0,0,0,6"
            BorderBrush="{Binding Color}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Profile Avatar Badge / Initials -->
            <Border Grid.Column="0"
                    Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="{Binding Color}"
                    Margin="0,0,8,0">
                <TextBlock Text="{Binding Initials}"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Profile Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Bold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="140"/>

                    <!-- Group Badge Pill (if present) -->
                    <Border Background="{Binding GroupColor}"
                            CornerRadius="4"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            Margin="4,0,0,0"
                            Visibility="{Binding GroupName, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding GroupName}"
                                   Foreground="White"
                                   FontSize="8"
                                   FontWeight="Bold"/>
                    </Border>
                </DockPanel>

                <!-- Subtitle / Email / Gaia Name -->
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Action Buttons: Protect (🛡️) & Quick Add (+) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <!-- Protect Shield Button -->
                <Button Click="OnProtectClick"
                        ToolTip="Toggle Protected Personal Profile"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2"
                        Margin="0,0,2,0"
                        FontSize="12"
                        Cursor="Hand">
                    <TextBlock Text="{Binding IsProtected, Converter={StaticResource ShieldIconConverter}}"
                               FontSize="12"/>
                </Button>

                <!-- Quick Add Button -->
                <Button Click="OnQuickAddClick"
                        ToolTip="Quick Add to First Empty Grid Cell"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="6,2"
                        FontSize="11"
                        Content="＋"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
